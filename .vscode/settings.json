{
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "json.schemas": [
        {
            "fileMatch": [
                "bucket/**/*.json"
            ],
            "url": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json"
        }
    ]
}
